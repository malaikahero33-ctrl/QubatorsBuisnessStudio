# Environment — NEVER commit real secrets
.env
.env.local
.env.development
.env.production
.env.*.local
!.env.example

# Test / coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini
ehthumbs_vista.db

# Runtime uploads (use Supabase Storage, not the filesystem)
uploads/
public/uploads/
tmp/
temp/

# Supabase CLI local state - caches, not source
supabase/.temp/
supabase/.branches/
supabase/.env
# ...but the migrations and seed ARE source and must be tracked
!supabase/migrations/
!supabase/seed.sql

# Archive — the legacy prototype is tracked deliberately, keep it.
# Do NOT blanket-ignore /archive/
