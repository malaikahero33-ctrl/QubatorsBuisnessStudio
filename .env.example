# ============================================================
# Qubators Business Studio - environment variables
# ============================================================
# Copy this file to `.env.local` and fill in the real values.
#
#   cp .env.example .env.local
#
# .env.local is git-ignored. NEVER commit real values.
# Every secret here must stay server-side. See docs/ARCHITECTURE.md.
# ============================================================


# ------------------------------------------------------------
# 1. Application
# ------------------------------------------------------------
# Public. Safe to expose to the browser.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Qubators Business Studio"

# Sign in at https://supabase.com/dashboard -> your project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"

# NEVER use the service_role key in any NEXT_PUBLIC_ variable.
# It bypasses row-level security and must stay on the server.
SUPABASE_SERVICE_ROLE_KEY=""

# The database password you set when creating the project.
# Used only by scripts/apply-migrations.mjs to run migrations directly.
# Not needed by the app at runtime. Delete this line once migrations are applied.
SUPABASE_DB_PASSWORD=""


# ------------------------------------------------------------
# 2. AI provider
# ------------------------------------------------------------
# Any OpenAI-compatible provider. The adapter lives in lib/ai/.
# See docs/DECISIONS.md for how the provider was chosen.
#
# Supported values: openai, groq, together, mistral, gemini,
#                   openai_compatible (self-hosted)
#
# --- GROQ (recommended to start) ---
# Sign up at https://console.groq.com -> API Keys. The free tier is
# generous and the models are fast, which matters on a poor connection.
#
#   AI_PROVIDER="groq"
#   AI_API_KEY="gsk-REPLACE-ME"
#
# Leave AI_MODEL_FAST and AI_MODEL_QUALITY unset on Groq and the
# per-provider defaults are used:
#     fast    -> llama-3.1-8b-instant      (copilot, marketing copy)
#     quality -> llama-3.3-70b-versatile   (business plan, brand kit)
#
# --- OPENAI ---
#   AI_PROVIDER="openai"
#   AI_API_KEY="sk-REPLACE-ME"
#   AI_MODEL_FAST="gpt-4o-mini"
#   AI_MODEL_QUALITY="gpt-4o"
#
# --- ANYTHING ELSE (OpenAI-compatible) ---
#   AI_PROVIDER="openai_compatible"
#   AI_BASE_URL="https://your-endpoint/v1"
#   AI_API_KEY="..."
#
# Only AI_PROVIDER and AI_API_KEY are required. The model names default
# per provider, so you do not have to know them to get started.
AI_PROVIDER="groq"
AI_API_KEY="gsk_2f8e9b1c0a7d4e93b1f6a7c4d5e6f789b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5"

# Only needed to override the per-provider defaults.
# AI_MODEL_FAST="llama-3.1-8b-instant"
# AI_MODEL_QUALITY="llama-3.3-70b-versatile"

# Only for AI_PROVIDER="openai_compatible".
# AI_BASE_URL="https://your-endpoint/v1"

# Guardrails against runaway AI cost. See PRD section 23.
AI_MAX_OUTPUT_TOKENS_CHAT="2000"
AI_MAX_OUTPUT_TOKENS_DOCUMENT="8000"
AI_REQUESTS_PER_USER_PER_DAY="50"
AI_REQUEST_TIMEOUT_MS="60000"


# ------------------------------------------------------------
# 3. Transactional email - ZeptoMail
# ------------------------------------------------------------
# Server-side only. See docs/ARCHITECTURE.md and the PRD.
# Requires a domain you control plus DNS verification records.
ZEPTOMAIL_API_TOKEN=""
ZEPTOMAIL_FROM_EMAIL="no-reply@YOUR-DOMAIN.com"
ZEPTOMAIL_FROM_NAME="Qubators Business Studio"
ZEPTOMAIL_REPLY_TO="support@YOUR-DOMAIN.com"


# ------------------------------------------------------------
# 4. Defaults
# ------------------------------------------------------------
# ISO 4217. Uganda is the launch market, so UGX is the default.
# UGX is a zero-decimal currency: store 10000 for ten thousand shillings.
DEFAULT_CURRENCY="UGX"
DEFAULT_LOCALE="en-UG"
DEFAULT_TIMEZONE="Africa/Kampala"


# ------------------------------------------------------------
# 5. Security
# ------------------------------------------------------------
# Used to sign tracking links and email verification tokens.
# Generate a new one for every environment:  openssl rand -hex 32
APP_SECRET=""

# Set to "true" in production to enforce secure cookies and HTTPS-only.
NODE_ENV="development"
