# ============================================================
# Qubators Business Studio - environment variables
# ============================================================
# Copy this file to `.env.local` and fill in the real values.
#
#   cp .env.example .env.local
#
# .env.local is git-ignored. NEVER commit real values.
# Every secret here must stay server-side. See docs/ARCHITECTURE.md.
# ============================================================


# ------------------------------------------------------------
# 1. Application
# ------------------------------------------------------------
# Public. Safe to expose to the browser.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Qubators Business Studio"

# Sign in at https://supabase.com/dashboard -> your project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"

# NEVER use the service_role key in any NEXT_PUBLIC_ variable.
# It bypasses row-level security and must stay on the server.
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"


# ------------------------------------------------------------
# 2. AI provider
# ------------------------------------------------------------
# Any OpenAI-compatible provider. The adapter lives in lib/ai/.
# See docs/DECISIONS.md for how the provider was chosen.
AI_PROVIDER="openai"
AI_API_KEY="sk-REPLACE-ME"

# Cheap model for chat, summaries and short copy.
AI_MODEL_FAST="gpt-4o-mini"
# Stronger model for business plans, brand strategy and long documents.
AI_MODEL_QUALITY="gpt-4o"

# Guardrails against runaway AI cost. See PRD section 23.
AI_MAX_OUTPUT_TOKENS_CHAT="2000"
AI_MAX_OUTPUT_TOKENS_DOCUMENT="8000"
AI_REQUESTS_PER_USER_PER_DAY="50"
AI_REQUEST_TIMEOUT_MS="60000"


# ------------------------------------------------------------
# 3. Transactional email - ZeptoMail
# ------------------------------------------------------------
# Server-side only. See docs/ARCHITECTURE.md and the PRD.
# Requires a domain you control plus DNS verification records.
ZEPTOMAIL_API_TOKEN=""
ZEPTOMAIL_FROM_EMAIL="no-reply@YOUR-DOMAIN.com"
ZEPTOMAIL_FROM_NAME="Qubators Business Studio"
ZEPTOMAIL_REPLY_TO="support@YOUR-DOMAIN.com"


# ------------------------------------------------------------
# 4. Defaults
# ------------------------------------------------------------
# ISO 4217. Uganda is the launch market, so UGX is the default.
# UGX is a zero-decimal currency: store 10000 for ten thousand shillings.
DEFAULT_CURRENCY="UGX"
DEFAULT_LOCALE="en-UG"
DEFAULT_TIMEZONE="Africa/Kampala"


# ------------------------------------------------------------
# 5. Security
# ------------------------------------------------------------
# Used to sign tracking links and email verification tokens.
# Generate a new one for every environment:  openssl rand -hex 32
APP_SECRET=""

# Set to "true" in production to enforce secure cookies and HTTPS-only.
NODE_ENV="development"
